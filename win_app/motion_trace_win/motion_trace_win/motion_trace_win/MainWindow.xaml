<Window
    x:Class="motion_trace_win.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:motion_trace_win"
    Title="MotionTrace">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid
        DragOver="OnDragOver"
        Drop="OnDrop"
        x:Name="Root"
        RequestedTheme="Default"
        AllowDrop="True">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary
                        x:Key="Dark">
                        <SolidColorBrush
                            x:Key="PanelOutlineBrush"
                            Color="#16FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary
                        x:Key="Light">
                        <SolidColorBrush
                            x:Key="PanelOutlineBrush"
                            Color="#14000000" />
                    </ResourceDictionary>
                    <ResourceDictionary
                        x:Key="HighContrast">
                        <SolidColorBrush
                            x:Key="PanelOutlineBrush"
                            Color="{ThemeResource SystemColorWindowTextColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style
                    x:Key="Card"
                    TargetType="Border">
                    <Setter
                        Property="Background"
                        Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter
                        Property="BorderBrush"
                        Value="{ThemeResource PanelOutlineBrush}" />
                    <Setter
                        Property="BorderThickness"
                        Value="1" />
                    <Setter
                        Property="CornerRadius"
                        Value="{ThemeResource OverlayCornerRadius}" />
                    <Setter
                        Property="Padding"
                        Value="20" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="48" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="AppTitleBar"
            Padding="26,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <Viewbox
                Width="34"
                Height="30"
                VerticalAlignment="Center">
                <Canvas
                    Width="884"
                    Height="701">
                    <Path
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        Data="M 866,23 L 860,17 L 857,16 L 709,16 L 685,21 L 663,30 L 639,45 L 606,72 L 501,168 L 493,174 L 480,187 L 475,190 L 407,253 L 396,259 L 384,258 L 374,251 L 258,136 L 216,96 L 203,90 L 188,88 L 173,91 L 162,97 L 34,223 L 24,238 L 19,251 L 16,266 L 16,665 L 18,670 L 24,675 L 28,676 L 34,675 L 41,671 L 151,574 L 163,562 L 173,546 L 177,531 L 177,292 L 178,288 L 182,284 L 185,283 L 193,288 L 347,435 L 364,443 L 384,442 L 391,439 L 404,429 L 525,318 L 549,298 L 594,257 L 613,243 L 639,227 L 673,210 L 709,190 L 733,172 L 864,43 L 867,37 Z" />
                    <Path
                        Fill="{ThemeResource TextFillColorPrimaryBrush}"
                        Data="M 725,242 L 660,274 L 640,286 L 618,302 L 593,323 L 560,354 L 550,368 L 544,381 L 541,391 L 540,404 L 539,405 L 539,668 L 543,677 L 546,680 L 552,683 L 564,684 L 575,681 L 583,677 L 596,668 L 677,599 L 686,590 L 692,586 L 710,569 L 720,553 L 725,534 Z" />
                </Canvas>
            </Viewbox>
            <TextBlock
                Grid.Column="1"
                Text="MotionTrace"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />
        </Grid>
        <Grid
            SizeChanged="OnWorkspaceSizeChanged"
            x:Name="Workspace"
            Grid.Row="1"
            Margin="16,16,16,8"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="VelocityColumn"
                    Width="0" />
                <ColumnDefinition
                    x:Name="VideoColumn"
                    Width="*" />
                <ColumnDefinition
                    x:Name="ResultsColumn"
                    Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl
                x:Name="PortraitVelocityHost"
                Grid.Column="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />
            <Grid
                Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <InfoBar
                    IsOpen="{Binding HasError}"
                    Severity="Error"
                    IsClosable="False"
                    Title="Something needs attention"
                    Message="{Binding Error}"
                    MaxHeight="150" />
                <Border
                    Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="*" />
                            <RowDefinition
                                Height="66" />
                        </Grid.RowDefinitions>
                        <Grid
                            Margin="20,12"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Spacing="3">
                                <Grid
                                    HorizontalAlignment="Left"
                                    ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="*" />
                                        <ColumnDefinition
                                            Width="Auto" />
                                        <ColumnDefinition
                                            Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{Binding FileName}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="·"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        x:Name="VideoAnalysisState"
                                        Grid.Column="2"
                                        Text="{Binding AnalysisStateText}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        AutomationProperties.LiveSetting="Polite" />
                                </Grid>
                                <TextBlock
                                    Text="{Binding VideoDetails}"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox
                                SelectionChanged="OnAspectRatioChanged"
                                x:Name="AspectRatioSelector"
                                Grid.Column="1"
                                SelectedIndex="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Video aspect ratio"
                                ToolTipService.ToolTip="Video display proportions">
                                <ComboBoxItem
                                    Content="Auto" />
                                <ComboBoxItem
                                    Content="16:9" />
                                <ComboBoxItem
                                    Content="9:16" />
                            </ComboBox>
                        </Grid>
                        <Grid
                            SizeChanged="OnVideoViewportSizeChanged"
                            x:Name="VideoViewport"
                            Grid.Row="1">
                            <ContentControl
                                IsTabStop="True"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                AutomationProperties.Name="Video point selection"
                                SizeChanged="OnVideoSizeChanged"
                                x:Name="VideoSurface"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                <Grid>
                                    <Grid
                                        x:Name="TrackingViewportContent">
                                        <Grid.RenderTransform>
                                            <CompositeTransform
                                                x:Name="TrackingViewportTransform" />
                                        </Grid.RenderTransform>
                                        <MediaPlayerElement
                                            x:Name="Player"
                                            AreTransportControlsEnabled="False"
                                            Stretch="Uniform" />
                                        <Canvas
                                            x:Name="OverlayCanvas"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />
                                        <local:TrackingPointCanvas
                                            PointerPressed="OnCorrectionPressed"
                                            PointerMoved="OnCorrectionMoved"
                                            PointerReleased="OnCorrectionReleased"
                                            PointerCanceled="OnCorrectionCanceled"
                                            x:Name="CorrectionCanvas"
                                            PointerExited="OnCorrectionExited"
                                            PointerWheelChanged="OnTrackingWheel"
                                            Visibility="Collapsed"
                                            Background="Transparent" />
                                    </Grid>
                                    <Border
                                        x:Name="TrackingPointNotice"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="12"
                                        Padding="12,8"
                                        CornerRadius="6"
                                        BorderBrush="#99FF9800"
                                        BorderThickness="1"
                                        IsHitTestVisible="False">
                                        <Border.Background>
                                            <AcrylicBrush
                                                TintColor="#FF9800"
                                                TintOpacity="0.3"
                                                Opacity="0.3"
                                                TintLuminosityOpacity="0"
                                                FallbackColor="#FFFF9800" />
                                        </Border.Background>
                                        <TextBlock
                                            Text="{Binding TargetNote}"
                                            Foreground="White"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            TextAlignment="Center" />
                                    </Border>
                                    <Grid
                                        x:Name="AnalysisProgressPanel"
                                        Visibility="Collapsed"
                                        Background="#D9000000">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                            <ProgressRing
                                                Width="20"
                                                Height="20"
                                                MinWidth="0"
                                                MinHeight="0"
                                                IsActive="{Binding IsAnalyzing}"
                                                Foreground="#60CDFF"
                                                AutomationProperties.Name="Analyzing video" />
                                            <TextBlock
                                                Text="{Binding AnalysisProgressText}"
                                                FontSize="11"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Grid>
                                    </Grid>
                            </ContentControl>
                            <ScrollViewer
                                x:Name="EmptyState"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalContentAlignment="Center">
                                <StackPanel
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Spacing="16"
                                    Margin="16">
                                    <FontIcon
                                        Glyph=""
                                        FontSize="42" />
                                    <TextBlock
                                        Text="Import a video"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="Drop a training video here to get started."
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" />
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Click="OnSelectVideo"
                                        Content="Select video"
                                        IsEnabled="{Binding CanImport}"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="24,10" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <Grid
                            Grid.Row="2"
                            Margin="16,8"
                            ColumnSpacing="12"
                            RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition
                                    Height="42" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="Auto" />
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="Auto" />
                                <ColumnDefinition
                                    Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                AllowFocusOnInteraction="False"
                                Click="OnPlayPause"
                                x:Name="PlayButton"
                                IsEnabled="False"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Play or pause">
                                <FontIcon
                                    x:Name="PlayIcon"
                                    Glyph=""
                                    FontSize="14" />
                            </Button>
                            <Slider
                                ValueChanged="OnSeek"
                                x:Name="Timeline"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="1"
                                IsEnabled="False"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Video position" />
                            <TextBlock
                                x:Name="TimeLabel"
                                Grid.Column="2"
                                Text="00:00 / 00:00"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button
                                AllowFocusOnInteraction="False"
                                x:Name="VolumeButton"
                                Grid.Column="3"
                                AutomationProperties.Name="Playback volume"
                                ToolTipService.ToolTip="Playback volume"
                                Width="32"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Center">
                                <FontIcon
                                    x:Name="VolumeIcon"
                                    Glyph=""
                                    FontSize="16" />
                                <Button.Flyout>
                                    <Flyout
                                        Placement="Top">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style
                                                TargetType="FlyoutPresenter">
                                                <Setter
                                                    Property="CornerRadius"
                                                    Value="{ThemeResource OverlayCornerRadius}" />
                                                <Setter
                                                    Property="Padding"
                                                    Value="8" />
                                                <Setter
                                                    Property="MinWidth"
                                                    Value="0" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel
                                            Width="40"
                                            Spacing="4">
                                            <TextBlock
                                                x:Name="VolumeLabel"
                                                Text="100%"
                                                HorizontalAlignment="Center" />
                                            <Slider
                                                ValueChanged="OnVolumeChanged"
                                                x:Name="VolumeSlider"
                                                Orientation="Vertical"
                                                Height="110"
                                                HorizontalAlignment="Center"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="100"
                                                StepFrequency="1"
                                                AutomationProperties.Name="Playback volume" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <ContentControl
                    x:Name="LandscapeVelocityHost"
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    HorizontalContentAlignment="Stretch">
                    <Border
                        x:Name="VelocityCard"
                        Style="{StaticResource Card}"
                        Padding="16">
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <StackPanel
                                Spacing="8"
                                Margin="0,0,18,0">
                                <Grid
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="*" />
                                        <ColumnDefinition
                                            Width="Auto" />
                                        <ColumnDefinition
                                            Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="Reps"
                                        FontWeight="SemiBold"
                                        FontSize="20"
                                        VerticalAlignment="Center" />
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Click="OnSelectAllReps"
                                        x:Name="SelectAllRepsButton"
                                        Grid.Column="1"
                                        Content="Select all"
                                        Padding="8,4" />
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Click="OnClearReps"
                                        x:Name="ClearRepsButton"
                                        Grid.Column="2"
                                        Content="Clear"
                                        Padding="8,4" />
                                </Grid>
                                <local:FlowPanel>
                                    <Button x:Name="CompareVideosButton"
                                            Content="Compare with another video"
                                            Click="OnCompareVideos"
                                            IsEnabled="False"
                                            AllowFocusOnInteraction="False"
                                            Margin="0,0,6,6" />
                                    <Button x:Name="EndVideoComparisonButton"
                                            Content="End comparison"
                                            Click="OnEndVideoComparison"
                                            Visibility="Collapsed"
                                            AllowFocusOnInteraction="False"
                                            Margin="0,0,0,6" />
                                </local:FlowPanel>
                                <StackPanel x:Name="VideoComparisonPanel"
                                            Spacing="8"
                                            Visibility="Collapsed">
                                    <ComboBox x:Name="DisplayedComparisonVideo"
                                              Header="Displayed video"
                                              DisplayMemberPath="Label"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnDisplayedVideoChanged" />
                                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="ComparisonRepRows" Spacing="8" Margin="0,0,16,0" />
                                    </ScrollViewer>
                                    <CheckBox x:Name="NormalizeVideoComparison"
                                              Content="Normalize to lifting ROM"
                                              IsChecked="True"
                                              Click="OnVideoComparisonNormalizationChanged" />
                                </StackPanel>
                                <DropDownButton
                                    x:Name="RepPicker"
                                    Content="Select reps"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left">
                                    <DropDownButton.Flyout>
                                        <Flyout
                                            Placement="BottomEdgeAlignedLeft">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style
                                                    TargetType="FlyoutPresenter">
                                                    <Setter
                                                        Property="CornerRadius"
                                                        Value="{ThemeResource OverlayCornerRadius}" />
                                                    <Setter
                                                        Property="HorizontalContentAlignment"
                                                        Value="Stretch" />
                                                    <Setter
                                                        Property="Padding"
                                                        Value="8" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <ScrollViewer
                                                MaxHeight="300"
                                                MinWidth="220">
                                                <ItemsControl
                                                    x:Name="RepTiles"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,18,0" />
                                            </ScrollViewer>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Click="OnReviewRep"
                                        x:Name="ReviewRepButton"
                                        Content="Play rep"
                                        IsEnabled="False"
                                        Padding="8,5" />
                                    <ComboBox
                                        SelectionChanged="OnChartPresentationChanged"
                                        x:Name="MainChartMode"
                                        SelectedIndex="0"
                                        AutomationProperties.Name="Chart metric">
                                        <ComboBoxItem
                                            Content="Velocity" />
                                        <ComboBoxItem
                                            Content="Height" />
                                    </ComboBox>
                                    <ComboBox
                                        SelectionChanged="OnChartPresentationChanged"
                                        x:Name="MainChartAxis"
                                        SelectedIndex="0"
                                        AutomationProperties.Name="X axis">
                                        <ComboBoxItem
                                            Content="Time" />
                                        <ComboBoxItem
                                            Content="ROM %" />
                                    </ComboBox>
                                    <DropDownButton
                                        Content="Phases"
                                        HorizontalAlignment="Left">
                                        <DropDownButton.Flyout>
                                            <Flyout
                                                Placement="BottomEdgeAlignedLeft">
                                                <StackPanel>
                                                    <CheckBox
                                                        Click="OnPhaseFilterChanged"
                                                        x:Name="ShowPreparation"
                                                        Content="Preparation"
                                                        Tag="0"
                                                        IsChecked="True" />
                                                    <CheckBox
                                                        Click="OnPhaseFilterChanged"
                                                        x:Name="ShowLowering"
                                                        Content="Lowering"
                                                        Tag="1"
                                                        IsChecked="True" />
                                                    <CheckBox
                                                        Click="OnPhaseFilterChanged"
                                                        x:Name="ShowBottomPause"
                                                        Content="Bottom pause"
                                                        Tag="2"
                                                        IsChecked="True" />
                                                    <CheckBox
                                                        Click="OnPhaseFilterChanged"
                                                        x:Name="ShowLifting"
                                                        Content="Lifting"
                                                        Tag="3"
                                                        IsChecked="True" />
                                                </StackPanel>
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                                <Grid
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="*" />
                                        <ColumnDefinition
                                            Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="ChartContext"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        TextWrapping="Wrap" />
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Grid.Column="1"
                                        Width="30"
                                        Height="32"
                                        Padding="0"
                                        AutomationProperties.Name="Chart information">
                                        <FontIcon
                                            Glyph=""
                                            FontSize="16" />
                                        <Button.Flyout>
                                            <Flyout>
                                                <TextBlock
                                                    x:Name="ChartHelp"
                                                    MaxWidth="350"
                                                    TextWrapping="Wrap" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <Canvas
                                    SizeChanged="OnMotionChartSizeChanged"
                                    x:Name="MovementOverview"
                                    Height="280"
                                    HorizontalAlignment="Stretch" />
                                <TextBlock
                                    x:Name="PlaybackValue"
                                    Text="No sample"
                                    FontSize="11"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="MeasurementCaption"
                                    Text="Wrist estimate · px / px/s · verify against the video"
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled">
                                    <StackPanel
                                        x:Name="RepTiming"
                                        Spacing="6"
                                        Margin="0,0,0,20" />
                                </ScrollViewer>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </ContentControl>
            </Grid>
            <Grid
                Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                        <Button
                            AllowFocusOnInteraction="False"
                            Click="OnAnalyze"
                            Content="{Binding AnalysisButtonText}"
                            IsEnabled="{Binding CanUseAnalysisButton}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <ToggleSwitch
                            Toggled="OnOverlayChanged"
                            x:Name="OverlayToggle"
                            OnContent="Pose"
                            OffContent="Pose"
                            AutomationProperties.Name="Pose overlay"
                            VerticalAlignment="Center"
                            IsOn="True"
                            FontSize="11"
                            MinWidth="90" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Button
                                AllowFocusOnInteraction="False"
                                Click="OnSelectVideo"
                                Content="Select video"
                                IsEnabled="{Binding CanImport}" />
                            <Button
                                AllowFocusOnInteraction="False"
                                x:Name="ExportButton"
                                Content="Export"
                                IsEnabled="False">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyout.MenuFlyoutPresenterStyle>
                                            <Style
                                                TargetType="MenuFlyoutPresenter">
                                                <Setter
                                                    Property="CornerRadius"
                                                    Value="{ThemeResource OverlayCornerRadius}" />
                                            </Style>
                                        </MenuFlyout.MenuFlyoutPresenterStyle>
                                        <MenuFlyoutItem
                                            Click="OnExportPackage"
                                            Text="Selected athletes: video + analysis + CSV (.zip)" />
                                        <MenuFlyoutItem
                                            Click="OnExportSamples"
                                            Text="Chart samples (.csv)" />
                                        <MenuFlyoutItem
                                            Click="OnExportReps"
                                            Text="Rep timings (.csv)" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Spacing="8"
                        Visibility="Collapsed">
                        <ComboBox
                            SelectionChanged="OnBarbellModelChanged"
                            x:Name="BarbellModelSelector"
                            Header="Tracking model"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="Show a prepared result. Changing this selection never starts analysis." />
                        <TextBlock
                            Text="{Binding SessionSummary}"
                            TextWrapping="Wrap"
                            FontSize="10" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                AllowFocusOnInteraction="False"
                                Click="OnAnalyzeMissing"
                                Content="Analyze missing models"
                                IsEnabled="{Binding CanAnalyze}" />
                            <Button
                                AllowFocusOnInteraction="False"
                                Click="OnRetryProvider"
                                Content="Retry selected"
                                IsEnabled="{Binding CanAnalyze}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                    <Grid
                        RowSpacing="14"
                        Margin="0,0,18,0">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Style="{StaticResource Card}">
                            <StackPanel
                                Spacing="12">
                                <Grid>
                                    <TextBlock
                                        Text="Athletes"
                                        FontSize="18"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding AthleteCount}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Click="OnSelectAllAthletes"
                                        Content="Select all"
                                        IsEnabled="{Binding HasResults}" />
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Click="OnClearAllAthletes"
                                        Content="Keep one"
                                        IsEnabled="{Binding HasResults}" />
                                </StackPanel>
                                <Button
                                    AllowFocusOnInteraction="False"
                                    Click="OnChooseManualAthlete"
                                    x:Name="ChooseManualAthleteButton"
                                    Content="Choose athlete manually"
                                    Visibility="Collapsed" />
                                <ItemsControl
                                    ItemsSource="{Binding Athletes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8"
                                                Padding="12,8"
                                                Margin="0,0,0,6">
                                                <CheckBox
                                                    Click="OnAthleteClicked"
                                                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                    HorizontalAlignment="Stretch">
                                                    <StackPanel
                                                        Spacing="3">
                                                        <TextBlock
                                                            Text="{Binding DisplayName}"
                                                            FontWeight="SemiBold" />
                                                        <TextBlock
                                                            Text="{Binding Detail}"
                                                            FontSize="10"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    Text="{Binding TrackingNote}"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Row="1"
                            Style="{StaticResource Card}"
                            VerticalAlignment="Stretch">
                            <StackPanel
                                Spacing="14">
                                <TextBlock
                                    Text="Movement summary"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <ItemsControl
                                    ItemsSource="{Binding ExerciseSummaryItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <local:FlowPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="8,5"
                                                Margin="0,0,6,6"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock
                                                    Text="{Binding}"
                                                    TextWrapping="Wrap"
                                                    FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    Text="Experimental · rule score is not probability. Bench press / Unknown only."
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    Text="Movement analysis"
                                    FontWeight="SemiBold" />
                                <InfoBar
                                    x:Name="AthleteNotice"
                                    IsOpen="False"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Title="Athlete not selected"
                                    Message="Select an athlete below and enable them in the Athletes panel to display reps and movement phases." />
                                <ComboBox
                                    SelectionChanged="OnMotionSourceChanged"
                                    x:Name="MotionAthlete"
                                    Header="Athlete for movement"
                                    PlaceholderText="No athletes available"
                                    IsEnabled="False"
                                    ItemsSource="{Binding Athletes}"
                                    DisplayMemberPath="DisplayName"
                                    HorizontalAlignment="Stretch" />
                                <StackPanel>
                                    <InfoBar
                                        x:Name="ExerciseNotice"
                                        IsOpen="False"
                                        IsClosable="False"
                                        Severity="Warning"
                                        Title="Exercise not recognized"
                                        Message="Select the exercise below to calculate reps and movement phases." />
                                    <ComboBox
                                        SelectionChanged="OnMotionSourceChanged"
                                        x:Name="MotionExercise"
                                        Header="Exercise"
                                        PlaceholderText="Not detected — select exercise"
                                        SelectedIndex="-1"
                                        HorizontalAlignment="Stretch">
                                        <ComboBoxItem
                                            Content="Bench press" />
                                        <ComboBoxItem
                                            Content="Squat" />
                                        <ComboBoxItem
                                            Content="Deadlift" />
                                        <ComboBoxItem
                                            Content="Snatch" />
                                        <ComboBoxItem
                                            Content="Clean and jerk" />
                                        <ComboBoxItem
                                            Content="Unknown" />
                                    </ComboBox>
                                </StackPanel>
                                <ComboBox
                                    SelectionChanged="OnMotionSourceChanged"
                                    x:Name="MotionSource"
                                    Header="Measurement source"
                                    SelectedIndex="1"
                                    HorizontalAlignment="Stretch">
                                    <ComboBoxItem
                                        Content="Wrist" />
                                    <ComboBoxItem
                                        Content="Barbell" />
                                </ComboBox>
                                <ComboBox
                                    SelectionChanged="OnMotionSourceChanged"
                                    x:Name="MotionWrist"
                                    Header="Tracked wrist"
                                    SelectedIndex="0"
                                    HorizontalAlignment="Stretch">
                                    <ComboBoxItem
                                        Content="Left wrist" />
                                    <ComboBoxItem
                                        Content="Right wrist" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="CorrectionObject"
                                    Visibility="Collapsed"
                                    Header="Object to correct"
                                    PlaceholderText="Choose an athlete first"
                                    DisplayMemberPath="Label"
                                    HorizontalAlignment="Stretch" />
                                <ComboBox
                                    x:Name="CorrectionMode"
                                    Visibility="Collapsed"
                                    Header="Correction on paused video"
                                    SelectedIndex="0"
                                    HorizontalAlignment="Stretch">
                                    <ComboBoxItem
                                        Content="Measurement point (click)" />
                                    <ComboBoxItem
                                        Content="Object box (drag)" />
                                </ComboBox>
                                <NumberBox
                                    x:Name="TargetAthlete"
                                    Visibility="Collapsed"
                                    Header="Target athlete ID (0 = automatic)"
                                    Value="0"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Compact" />
                                <Button
                                    AllowFocusOnInteraction="False"
                                    Click="OnBeginCorrection"
                                    x:Name="CorrectionButton"
                                    Visibility="Collapsed"
                                    Content="Mark in video"
                                    IsEnabled="{Binding CanCorrectObjects}" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Content="Undo point"
                                        Click="OnUndoTrackingPoint"
                                        IsEnabled="{Binding CanRemoveTrackingPoints}" />
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Content="Clear points"
                                        Click="OnClearTrackingPoints"
                                        IsEnabled="{Binding CanRemoveTrackingPoints}" />
                                </StackPanel>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Content="-"
                                        Click="OnTrackingZoomOut"
                                        IsEnabled="{Binding CanEditTrackingPoints}"
                                        AutomationProperties.Name="Zoom out" />
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Content="+"
                                        Click="OnTrackingZoomIn"
                                        IsEnabled="{Binding CanEditTrackingPoints}"
                                        AutomationProperties.Name="Zoom in" />
                                    <Button
                                        AllowFocusOnInteraction="False"
                                        Content="Fit"
                                        Click="OnTrackingZoomReset"
                                        IsEnabled="{Binding CanEditTrackingPoints}" />
                                </StackPanel>
                                <TextBlock
                                    Text="Wheel to zoom · right-drag to pan"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="CorrectionNote"
                                    Text="{Binding TargetNote}"
                                    TextWrapping="Wrap"
                                    FontSize="11" />
                                <NumberBox
                                    ValueChanged="OnMotionThresholdChanged"
                                    x:Name="MotionThreshold"
                                    Visibility="Collapsed"
                                    Header="Clear movement (% of image height)"
                                    Value="1.5"
                                    Minimum="0.2"
                                    Maximum="10"
                                    SmallChange="0.1"
                                    SpinButtonPlacementMode="Compact" />
                                <TextBlock
                                    Text="Object measurements may be a mask proxy, not the shaft axis. A manually selected point is tracked independently. Wrist measurements use the selected hand. Units: px and px/s."
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="MotionNote"
                                    Text="Analyze a video, then choose an athlete and wrist."
                                    FontSize="11"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="MovementStatus"
                                    Text="Waiting"
                                    FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
            <Border
                PointerPressed="OnDividerPressed"
                PointerMoved="OnDividerMoved"
                PointerReleased="OnDividerReleased"
                PointerCaptureLost="OnDividerCaptureLost"
                x:Name="LeftDivider"
                Grid.Column="0"
                Width="12"
                Margin="0,0,-14,0"
                HorizontalAlignment="Right"
                Background="Transparent"
                ManipulationMode="None"
                ToolTipService.ToolTip="Drag to resize columns" />
            <Border
                PointerPressed="OnDividerPressed"
                PointerMoved="OnDividerMoved"
                PointerReleased="OnDividerReleased"
                PointerCaptureLost="OnDividerCaptureLost"
                x:Name="RightDivider"
                Grid.Column="1"
                Width="12"
                Margin="0,0,-14,0"
                HorizontalAlignment="Right"
                Background="Transparent"
                ManipulationMode="None"
                ToolTipService.ToolTip="Drag to resize columns" />
        </Grid>
    </Grid>
</Window>
